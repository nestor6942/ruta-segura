# RUTA SEGURA — CONFIGURACIÓN DEL SERVIDOR & PASARELAS DE PAGO
PORT=3000

# 1. TWILIO API (Alertas de WhatsApp y SMS)
# Obtén tus credenciales gratis en https://console.twilio.com
TWILIO_ACCOUNT_SID=AC_tu_twilio_account_sid
TWILIO_AUTH_TOKEN=tu_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# 2. STRIPE API (Cobros Directos con Tarjeta, Apple Pay y Google Pay)
# Crea tu cuenta en https://dashboard.stripe.com
# Prueba: inicia con sk_test_... | Producción: sk_live_...
STRIPE_SECRET_KEY=sk_test_tu_clave_secreta_stripe
STRIPE_PUBLISHABLE_KEY=pk_test_tu_clave_publica_stripe
STRIPE_WEBHOOK_SECRET=whsec_tu_secreto_webhook_stripe

# 3. MERCADO PAGO (Cobros en México con Tarjetas, SPEI y OXXO)
# Obtén tu Access Token en https://www.mercadopago.com.mx/developers
MERCADOPAGO_ACCESS_TOKEN=TEST-tu_access_token_mercadopago

# 4. REVENUECAT API (Compras dentro de la app para Google Play / App Store)
# Configura tu proyecto en https://app.revenuecat.com
REVENUECAT_SECRET_KEY=sk_mock_revenuecat_secret_key
REVENUECAT_WEBHOOK_AUTH_HEADER=Bearer rc_webhook_secret_token

# 5. BASE DE DATOS (OPCIONAL)
# Por defecto la app almacena todo en 'data/database.json' con persistencia atómica.
# Si deseas conectar MongoDB Atlas en la nube, coloca tu URL aquí:
# MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/ruta_segura
